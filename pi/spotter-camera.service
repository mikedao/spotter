# The Pi at the target streams the camera (a Logitech C920 since 2026-11-23; was
# the Razer Kiyo) to the laptop: ustreamer passes the camera's own MJPEG frames
# through (--encoder=HW, no re-encoding on a Pi 3).
# Install: see pi/README.md. Replace YOUR_USER with the Pi login (setup does it).
# The camera's settings are NOT here: spotter-camera-controls.service applies them
# after the stream starts and again on every plug-in (a C920 forgets them).
[Unit]
Description=Spotter: stream the camera to the laptop (MJPEG, port 8080)
After=network-online.target
Wants=network-online.target spotter-camera-controls.service

[Service]
User=YOUR_USER
ExecStart=/usr/bin/ustreamer --device=/dev/video0 --format=MJPEG --encoder=HW --resolution=1920x1080 --desired-fps=10 --host=0.0.0.0 --port=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
