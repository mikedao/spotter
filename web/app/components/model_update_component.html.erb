<%= render(CardComponent.new(title: "Scoring model", id: "model_update")) do %>
  <div class="space-y-3 text-sm">
    <% if state.running? %>
      <p class="flex items-center gap-2 font-medium" role="status">
        <span class="inline-block size-2 animate-pulse rounded-full bg-blue-600"></span>
        <%= state.step_label %>…
      </p>
      <p class="text-gray-600 dark:text-gray-300">
        Retraining takes about 15 minutes. You can leave this page; don't start a session until it's done.
      </p>
    <% elsif !ready? %>
      <p class="text-gray-600 dark:text-gray-300">
        <%= pluralize(left, "shot") %> still to review. Once every shot has a call, the model can be updated from here.
      </p>
      <% if (shot = first_unreviewed) %>
        <%= render(ButtonComponent.new(href: helpers.shot_path(shot), variant: :secondary, size: :sm)) { "Review shots" } %>
      <% end %>
    <% else %>
      <% if state.done? %>
        <% if this_session && this_session["model_n"].to_i.positive? %>
          <p>
            Rings that matched your calls this session:
            <strong>engine <%= of(this_session["agree"], this_session["n"]) %></strong>,
            <strong>model <%= of(this_session["model_agree"], this_session["model_n"]) %></strong>.
          </p>
        <% else %>
          <p class="text-gray-600 dark:text-gray-300">
            The model wasn't running during this session, so there's nothing of its to compare yet.
            <% if this_session %>The engine matched <%= of(this_session["agree"], this_session["n"]) %> of your rings.<% end %>
          </p>
        <% end %>
        <% if overall && overall["model"] && overall["model"]["n"].to_i.positive? %>
          <p class="text-gray-600 dark:text-gray-300">
            All sessions, live: engine <%= of(overall.dig("rules", "agree"), overall.dig("rules", "n")) %>,
            model <%= of(overall.dig("model", "agree"), overall.dig("model", "n")) %>.
          </p>
        <% end %>
        <% if trained %>
          <p class="text-gray-600 dark:text-gray-300">
            Retrained on <%= pluralize(trained["trained_on"], "called shot") %>
            <% if (cv = trained["cv"]) %>
              - on <%= cv["by"] == "session" ? "sessions" : "cards" %> it hadn't seen:
              engine <%= of(cv["rules_agree"], cv["n"]) %>, model <%= of(cv["model_agree"], cv["n"]) %>
            <% end %>.
            Your next session uses it.
          </p>
        <% end %>
        <%= button("Run again", variant: :secondary) unless live_session? || busy_elsewhere %>
      <% elsif state.failed? %>
        <p class="text-red-700 dark:text-red-300" role="alert">The update stopped: <%= state.error %></p>
      <% else %>
        <p class="text-gray-600 dark:text-gray-300">
          Every shot has a call. Compare the engine and the model with your calls, then retrain the model on them (about 15 minutes).
        </p>
      <% end %>

      <% if live_session? %>
        <p class="text-gray-600 dark:text-gray-300">A session is running - update the model after it.</p>
      <% elsif busy_elsewhere %>
        <p class="text-gray-600 dark:text-gray-300">Another update is running (<%= busy_elsewhere.title %>).</p>
      <% elsif !state.done? %>
        <%= button(state.failed? ? "Try again" : "Update the scoring model") %>
      <% end %>
    <% end %>
  </div>
<% end %>
