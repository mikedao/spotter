<%# The instructions are always in view (the shooter wants the reminder while
    shooting); the rest - cards, groups, tags, the whole day - opens below. %>
<details class="group rounded-lg border border-blue-200 bg-blue-50 dark:border-blue-900 dark:bg-blue-950/40" data-plan-block>
  <summary class="flex min-h-11 cursor-pointer flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-2 select-none">
    <span class="shrink-0 self-center rounded bg-blue-600 px-2 py-0.5 text-sm font-medium text-white">Plan</span>
    <span class="min-w-0 font-semibold"><%= block.name %></span>
    <span class="text-sm text-gray-600 dark:text-gray-300">Week <%= found.day.week %> · Day <%= found.day.day %></span>
    <% if shots %><span class="shrink-0 text-sm tabular-nums text-gray-700 dark:text-gray-200"><%= shots %> shots</span><% end %>
    <span class="ml-auto shrink-0 text-sm text-gray-600 dark:text-gray-300"><span class="group-open:hidden">more ▾</span><span class="hidden group-open:inline">less ▴</span></span>
    <span class="basis-full text-gray-800 dark:text-gray-100" data-plan-instructions><%= block.detail %></span>
  </summary>
  <div class="border-t border-blue-200 px-4 py-3 text-sm text-gray-700 dark:border-blue-900 dark:text-gray-200">
    <% if block.session.course == "match" %>Match: the range officer runs the clock. <% end %>
    Cards of <%= block.session.per_card %><% if group_of %>, measured in groups of <%= group_of %><% end %>.
    <% if block.session.tags.any? %>Tagged <%= block.session.tags.to_sentence %>.<% end %>
    <%= helpers.link_to "The whole day", helpers.plan_workout_path(found.day.week, found.day.day), class: "ml-1 text-blue-700 underline dark:text-blue-300" %>
  </div>
</details>
