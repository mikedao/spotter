<%= render(CardComponent.new(title: title, id: "session_result")) do %>
  <p class="flex flex-wrap items-baseline gap-x-3">
    <span class="text-6xl font-bold tabular-nums"><%= total %></span>
    <% if out_of %><span class="text-lg text-gray-600 dark:text-gray-300"><%= out_of %></span><% end %>
  </p>
  <% if event&.penalties&.positive? || sighters.positive? %>
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
      <%= [ (helpers.pluralize(sighters, "sighter") + " (not counted)" if sighters.positive?),
            ("#{helpers.pluralize(event.penalties, 'shot')} out of time, scored zero" if event&.penalties&.positive?) ].compact.join(" · ") %>
    </p>
  <% end %>

  <% if series.any? %>
    <ol class="mt-3 flex flex-wrap gap-1.5 text-sm tabular-nums" aria-label="Series totals">
      <% series.each do |label, value| %>
        <li class="<%= classes("rounded-md border px-2 py-1", value == worst && series.size > 1 ? "border-red-400 dark:border-red-700" : "border-gray-300 dark:border-gray-700") %>">
          <span class="text-gray-600 dark:text-gray-300"><%= label %></span> <span class="font-semibold"><%= value %></span>
        </li>
      <% end %>
    </ol>
    <% if series.size > 1 %><p class="mt-1 text-xs text-gray-600 dark:text-gray-300">Outlined in red: the worst series.</p><% end %>
  <% end %>

  <dl class="mt-4 grid grid-cols-3 gap-x-4 gap-y-3 border-t border-gray-200 pt-4 dark:border-gray-800">
    <% figures.each do |label, value| %>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-300"><%= label %></dt>
        <dd class="text-lg font-semibold tabular-nums"><%= value %></dd>
      </div>
    <% end %>
  </dl>
<% end %>

<%= render(CardComponent.new(title: "Cards")) do %>
  <ul class="-mx-4 -mb-4 divide-y divide-gray-200 sm:-mx-5 sm:-mb-5 dark:divide-gray-800">
    <% session.cards.each do |card| %>
      <% s = card.stats %>
      <li>
        <%= link_to helpers.practice_session_card_path(session, card.number),
              class: "flex min-h-11 flex-wrap items-center justify-between gap-2 px-4 py-2 hover:bg-gray-50 sm:px-5 dark:hover:bg-gray-800" do %>
          <span class="font-medium text-blue-700 dark:text-blue-300">Card <%= card.number %> →</span>
          <span class="tabular-nums text-gray-600 dark:text-gray-300">
            <%= s.any? ? s.score : "–" %> over <%= helpers.pluralize(s.count, "shot") %><%= " · group #{s.group_size_mm} mm" if s.group_size_mm %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
