<% case section %>
<% when :target %>
  <div id="<%= dom_id %>" class="<%= LivePanelComponent::TARGET_SIZE %>">
    <%= render(CardComponent.new(padding: :none, class: "relative p-2")) do %>
      <span class="absolute left-4 top-3 text-sm font-semibold text-gray-700">Card <%= card_number %></span>
      <%= render(TargetSvgComponent.new(spec:, shots: scored, latest:, label: "Card #{card_number}", group_of:)) %>
      <% if (group = groups.last) && group.size_mm %>
        <span class="absolute right-4 top-3 rounded bg-white/85 px-2 text-sm font-semibold tabular-nums text-red-700">
          Group <%= group.number %>: <%= group.size_mm %> mm<%= " (#{group_of - group.shots.size} to go)" unless group.complete %>
        </span>
      <% end %>
    <% end %>
  </div>
<% when :latest %>
  <div id="<%= dom_id %>">
    <%# No heading: the big score and "shot 10 · high left" say what it is, and the
        space goes to the camera below (it must fit on a laptop screen while live). %>
    <%= render(CardComponent.new("aria-label": "Latest shot")) do %>
      <% if (missed = unplotted_capture) %>
        <%= link_to helpers.plot_shot_path(missed), data: { turbo_frame: "plot" },
              class: "mb-3 flex min-h-11 items-center justify-between gap-3 rounded-md border border-amber-400 bg-amber-50 px-3 py-2 font-medium text-amber-900 hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100" do %>
          <span>Shot not scored <span class="font-normal">- <%= missed.unscored_reason %></span></span>
          <span class="whitespace-nowrap underline">Plot it →</span>
        <% end %>
      <% end %>
      <% if latest %>
        <%= link_to shot_path(latest), class: "block" do %>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <span class="text-7xl font-bold tabular-nums short:text-5xl max-sm:text-6xl"><%= format("%.1f", latest.final_decimal) %></span>
            <%# Points where the shot went, at its exact angle (y is UP in target mm). %>
            <% if (angle = direction_angle(latest)) %>
              <svg viewBox="0 0 24 24" class="size-12 shrink-0 text-gray-700 short:size-9 dark:text-gray-200" aria-hidden="true"
                   style="transform: rotate(<%= angle.round %>deg)">
                <path d="M3 12h15M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% else %>
              <svg viewBox="0 0 24 24" class="size-12 shrink-0 text-gray-700 short:size-9 dark:text-gray-200" aria-hidden="true">
                <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="12" cy="12" r="3" fill="currentColor"/>
              </svg>
            <% end %>
            <span class="text-2xl text-gray-600 short:text-lg dark:text-gray-300">
              <%= latest.stage_label || "shot #{latest.number}" %> · <%= latest.direction %><%= " · inner ten" if latest.final_inner_ten? %>
            </span>
          </div>
          <% if latest.penalized? %>
            <p class="mt-2 font-medium text-red-700 dark:text-red-300"><%= latest.penalty.upcase_first %> - scores zero</p>
          <% end %>
          <% if latest.flagged? && !latest.called? %>
            <p class="mt-2 font-medium text-red-700 dark:text-red-300">Check by eye: <%= latest.flags.to_sentence %></p>
          <% end %>
        <% end %>
        <%# Every shot on this card so far, oldest first, as whole rings (your call wins;
            a penalized shot is 0). Same colours as the target: the latest ringed in
            amber, red = flagged and not yet checked by you; penalized struck through. %>
        <% if group_of && groups.any? %>
          <%# Shooting in runs: each group of the card on its own line with its size,
              the one being shot highlighted (it stays so once full, until the next shot). %>
          <ol class="mt-3 space-y-1.5 border-t border-gray-200 pt-3 dark:border-gray-800" aria-label="Groups of <%= group_of %> on this card">
            <% groups.each do |group| %>
              <% current = group == groups.last %>
              <li class="<%= classes("flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-md px-2 py-1.5 -mx-2",
                                     current ? "bg-amber-50 dark:bg-amber-950/40" : "opacity-60") %>"
                  data-group="<%= group.number %>" <%= "aria-current=true" if current %>>
                <span class="w-16 shrink-0 text-sm font-medium text-gray-600 dark:text-gray-300">Group <%= group.number %></span>
                <ol class="flex flex-wrap gap-1.5" aria-label="Group <%= group.number %>, <%= group.range_text %>">
                  <% group.shots.each do |shot| %><li><%= chip(shot) %></li><% end %>
                </ol>
                <span class="ml-auto text-right tabular-nums">
                  <span class="<%= classes("font-semibold", current ? "text-2xl" : "text-lg") %>"><%= group.size_mm ? "#{group.size_mm} mm" : "–" %></span>
                  <% unless group.complete %>
                    <span class="block text-sm text-gray-600 dark:text-gray-300"><%= group_of - group.shots.size %> to go</span>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <ol class="mt-3 flex flex-wrap gap-1.5 border-t border-gray-200 pt-3 dark:border-gray-800" aria-label="Shots on this card">
            <% scored.each do |shot| %><li><%= chip(shot) %></li><% end %>
          </ol>
        <% end %>
      <% else %>
        <div class="flex flex-wrap items-baseline gap-x-3 text-gray-400 dark:text-gray-500">
          <span class="text-5xl font-bold tabular-nums">–</span>
          <span class="text-lg">no shots on this card yet</span>
        </div>
      <% end %>
    <% end %>
  </div>
<% when :stats %>
  <%# tall: in two columns; without a match clock it is the odd one out, so it
      takes the whole row. %>
  <div id="<%= dom_id %>" class="<%= "tall:col-span-2" unless @session.course %>">
    <%= render(CardStatsComponent.new(stats:, group_of:)) %>
  </div>
<% when :list %>
  <div id="<%= dom_id %>" class="space-y-4 tall:col-span-2">
    <%= render(ShotListComponent.new(shots:, live: @session.live?)) %>

    <% if earlier_cards.any? %>
      <%= render(CardComponent.new(title: "Earlier cards this session")) do %>
        <ul class="divide-y divide-gray-200 dark:divide-gray-800">
          <% earlier_cards.reverse_each do |card| %>
            <% s = card.stats %>
            <li class="-mx-4 flex items-center sm:-mx-5">
              <%# Live: the card's page in a new tab, and Delete in place - leaving
                  the range screen would stop its microphone and announcer. %>
              <%= link_to helpers.practice_session_card_path(@session, card.number), target: (@session.live? ? "_blank" : nil),
                    class: "flex min-h-11 flex-1 flex-wrap items-center justify-between gap-2 px-4 py-2 hover:bg-gray-50 sm:px-5 dark:hover:bg-gray-800" do %>
                <span class="font-medium text-blue-700 dark:text-blue-300">Card <%= card.number %> →</span>
                <span class="tabular-nums text-gray-600 dark:text-gray-300">
                  <%= s.score %> over <%= pluralize(s.count, "shot") %><%= (sizes = @session.group_of ? s.group_sizes(of: @session.group_of) : []).any? ? " · groups #{sizes.join(', ')} mm" : (" · group #{s.group_size_mm} mm" if s.group_size_mm) %>
                </span>
              <% end %>
              <% if @session.live? %>
                <%= button_to "Delete", helpers.practice_session_card_path(@session, card.number, back: "live"), method: :delete,
                      "aria-label": "Delete card #{card.number}",
                      form: { class: "shrink-0 px-2", data: { turbo_confirm: "Delete card #{card.number}#{" and its #{pluralize(s.count, 'shot')}" if s.count.positive?}? Later cards and shots are renumbered. This can't be undone." } },
                      class: "min-h-11 cursor-pointer rounded-md px-3 text-sm text-gray-500 hover:bg-red-50 hover:text-red-700 dark:text-gray-400 dark:hover:bg-red-950 dark:hover:text-red-300" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
<% end %>
