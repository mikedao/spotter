<% case section %>
<% when :target %>
  <div id="<%= dom_id %>" class="<%= LivePanelComponent::TARGET_SIZE %>">
    <%= render(CardComponent.new(padding: :none, class: "relative p-2")) do %>
      <span class="absolute left-4 top-3 text-sm font-semibold text-gray-700">Card <%= card_number %></span>
      <%= render(TargetSvgComponent.new(spec:, shots: scored, latest:, label: "Card #{card_number}")) %>
    <% end %>
  </div>
<% when :latest %>
  <div id="<%= dom_id %>">
    <%# No heading: the big score and "shot 10 · high left" say what it is, and the
        space goes to the camera below (it must fit on a laptop screen while live). %>
    <%= render(CardComponent.new("aria-label": "Latest shot")) do %>
      <% if (missed = unplotted_capture) %>
        <%= link_to helpers.plot_shot_path(missed), data: { turbo_frame: "plot" },
              class: "mb-3 flex min-h-11 items-center justify-between gap-3 rounded-md border border-amber-400 bg-amber-50 px-3 py-2 font-medium text-amber-900 hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100" do %>
          <span>Shot not scored <span class="font-normal">- <%= missed.unscored_reason %></span></span>
          <span class="whitespace-nowrap underline">Plot it →</span>
        <% end %>
      <% end %>
      <% if latest %>
        <%= link_to shot_path(latest), class: "block" do %>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <span class="text-7xl font-bold tabular-nums"><%= format("%.1f", latest.final_decimal) %></span>
            <%# Points where the shot went, at its exact angle (y is UP in target mm). %>
            <% if (angle = direction_angle(latest)) %>
              <svg viewBox="0 0 24 24" class="size-12 shrink-0 text-gray-700 dark:text-gray-200" aria-hidden="true"
                   style="transform: rotate(<%= angle.round %>deg)">
                <path d="M3 12h15M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% else %>
              <svg viewBox="0 0 24 24" class="size-12 shrink-0 text-gray-700 dark:text-gray-200" aria-hidden="true">
                <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="12" cy="12" r="3" fill="currentColor"/>
              </svg>
            <% end %>
            <span class="text-2xl text-gray-600 dark:text-gray-300">
              <%= latest.stage_label || "shot #{latest.number}" %> · <%= latest.direction %><%= " · inner ten" if latest.final_inner_ten? %>
            </span>
          </div>
          <% if latest.penalized? %>
            <p class="mt-2 font-medium text-red-700 dark:text-red-300"><%= latest.penalty.upcase_first %> - scores zero</p>
          <% end %>
          <% if latest.flagged? && !latest.called? %>
            <p class="mt-2 font-medium text-red-700 dark:text-red-300">Check by eye: <%= latest.flags.to_sentence %></p>
          <% end %>
        <% end %>
        <%# Every shot on this card so far, oldest first, as whole rings (your call wins;
            a penalized shot is 0). Same colours as the target: the latest ringed in
            amber, red = flagged and not yet checked by you; penalized struck through. %>
        <ol class="mt-3 flex flex-wrap gap-1.5 border-t border-gray-200 pt-3 dark:border-gray-800" aria-label="Shots on this card">
          <% scored.each do |shot| %>
            <li>
              <%= link_to (shot.penalized? ? 0 : shot.final_ring), shot_path(shot),
                    "aria-label": "#{shot.stage_label || "Shot #{shot.number}"}: #{shot.penalized? ? 0 : shot.final_ring}",
                    class: classes("grid h-9 min-w-9 place-items-center rounded-md border px-1.5 text-lg font-semibold tabular-nums hover:bg-gray-100 dark:hover:bg-gray-800",
                                   if shot.penalized? then "border-gray-300 text-gray-500 line-through dark:border-gray-700"
                                   elsif shot.flagged? && !shot.called? then "border-red-500 text-red-700 dark:border-red-500 dark:text-red-300"
                                   else "border-gray-300 dark:border-gray-700" end,
                                   ("ring-2 ring-amber-500 ring-offset-1 ring-offset-white dark:ring-offset-gray-900" if shot == latest)) %>
            </li>
          <% end %>
        </ol>
      <% else %>
        <div class="flex flex-wrap items-baseline gap-x-3 text-gray-400 dark:text-gray-500">
          <span class="text-5xl font-bold tabular-nums">–</span>
          <span class="text-lg">no shots on this card yet</span>
        </div>
      <% end %>
    <% end %>
  </div>
<% when :stats %>
  <div id="<%= dom_id %>">
    <%= render(CardStatsComponent.new(stats:)) %>
  </div>
<% when :list %>
  <div id="<%= dom_id %>" class="space-y-4">
    <%= render(ShotListComponent.new(shots:, plot: @session.live?)) %>

    <% if earlier_cards.any? %>
      <%= render(CardComponent.new(title: "Earlier cards this session")) do %>
        <ul class="divide-y divide-gray-200 dark:divide-gray-800">
          <% earlier_cards.reverse_each do |card| %>
            <% s = card.stats %>
            <li>
              <%= link_to helpers.practice_session_card_path(@session, card.number),
                    class: "-mx-4 flex min-h-11 flex-wrap items-center justify-between gap-2 px-4 py-2 hover:bg-gray-50 sm:-mx-5 sm:px-5 dark:hover:bg-gray-800" do %>
                <span class="font-medium text-blue-700 dark:text-blue-300">Card <%= card.number %> →</span>
                <span class="tabular-nums text-gray-600 dark:text-gray-300">
                  <%= s.score %> over <%= pluralize(s.count, "shot") %><%= " · group #{s.group_size_mm} mm" if s.group_size_mm %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
<% end %>
