<div id="listen_panel" class="space-y-3">
  <% if @state.nil? %>
    <p class="text-sm text-gray-600 dark:text-gray-300">Press Listen, wait while it measures the room, then fire a shot or two.</p>
  <% else %>
    <div class="flex flex-wrap items-center gap-3">
      <% if running? %>
        <span class="inline-flex items-center gap-2 font-medium text-green-800 dark:text-green-300">
          <span class="inline-block size-2.5 animate-pulse rounded-full bg-current"></span>
          Sound check on <%= data["mic"] %>
        </span>
        <%= button_to "Stop", helpers.setup_stop_listen_path, class: "cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" %>
      <% else %>
        <span class="font-medium">Finished: <%= data["mic"] %></span>
      <% end %>
    </div>

    <%= render(ListenMeterComponent.new(state: @state)) %>

    <% if @state.error %>
      <p class="rounded-md bg-red-50 p-3 text-red-900 dark:bg-red-950 dark:text-red-200"><%= @state.error %></p>
    <% end %>

    <% if sounds.any? && summary.nil? %>
      <p class="text-sm text-gray-700 dark:text-gray-200"><strong><%= pluralize(shots, "sound") %> would trigger</strong> out of <%= sounds.size %> heard so far.</p>
    <% end %>
    <% if (sum = summary) %>
      <% if sum["silent"] %>
        <p class="rounded-md bg-red-50 p-3 text-red-900 dark:bg-red-950 dark:text-red-200">
          The microphone returned pure silence. On macOS that usually means no permission: allow the terminal that runs Spotter
          in System Settings › Privacy &amp; Security › Microphone, then restart it.
        </p>
      <% else %>
        <p class="text-sm text-gray-700 dark:text-gray-200">
          <strong><%= pluralize(shots, "sound") %> would trigger</strong> out of <%= sounds.size %> heard.
          A capture needs at least +<%= data["trigger_db"].to_f.round %> dB over the room and <%= data["trigger_ms"].to_f.round %> ms.
          Room noise floor <%= sum["floor_dbfs"] %> dBFS.
          <% if sounds.any? && shots.zero? %>
            None of these would trigger: if they were shots, the microphone is too far, too muffled, or filtering
            sharp sounds (turn off noise suppression) - or use "No microphone - camera only".
          <% end %>
        </p>
      <% end %>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3 border-t border-gray-200 pt-4 dark:border-gray-800">
    <% if heard_a_shot? %>
      <%= render(ButtonComponent.new(href: helpers.setup_start_path, size: :lg)) { "Next: start" } %>
    <% else %>
      <%= render(ButtonComponent.new(size: :lg, disabled: true)) { "Next: start" } %>
      <span class="text-sm text-gray-600 dark:text-gray-300">Unlocks once a shot would trigger.</span>
    <% end %>
    <%= button_to "No microphone - camera only", helpers.setup_microphone_path, params: { mic: CameraProbe::NO_MIC },
          class: "ml-auto cursor-pointer text-sm text-gray-600 underline dark:text-gray-300",
          form: { data: { turbo_confirm: "Without a microphone the camera finds each shot instead: slower, 2-4 s per shot. Continue?", confirm_button: "Camera only" } } %>
  </div>

  <% if @state %>
    <%# Newest first and only the last few: the sound you just made is always at the
        top, and the page stays the same height however much it hears. %>
    <% if sounds.any? %>
      <%= render_sounds(latest_sounds) %>
      <% if earlier_sounds.any? %>
        <details class="text-sm">
          <summary class="cursor-pointer text-gray-600 dark:text-gray-300">Show <%= pluralize(earlier_sounds.size, "earlier sound") %></summary>
          <div class="mt-2"><%= render_sounds(earlier_sounds, head: false) %></div>
        </details>
      <% end %>
    <% elsif running? %>
      <p class="text-sm text-gray-600 dark:text-gray-300">No sharp sounds yet.</p>
    <% end %>
  <% end %>
</div>
