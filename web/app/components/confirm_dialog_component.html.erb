<dialog id="confirm_dialog" role="alertdialog" aria-modal="true" aria-label="Please confirm" aria-describedby="confirm_dialog_message"
        data-controller="confirm-dialog" data-action="close->confirm-dialog#cancel click->confirm-dialog#backdrop"
        class="m-auto w-[min(28rem,calc(100vw-2rem))] rounded-lg border border-gray-200 bg-white p-0 text-gray-900 shadow-xl backdrop:bg-black/60 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-100">
  <div class="p-5">
    <p id="confirm_dialog_message" class="text-base" data-confirm-dialog-target="message"></p>
    <div class="mt-5 flex flex-wrap justify-end gap-2">
      <%= render(ButtonComponent.new(variant: :secondary, data: { confirm_dialog_target: "cancel", action: "confirm-dialog#cancel" })) { "Cancel" } %>
      <%= render(ButtonComponent.new(variant: :danger, hidden: true, data: { confirm_dialog_target: "danger", action: "confirm-dialog#accept" })) { "Delete" } %>
      <%= render(ButtonComponent.new(variant: :primary, data: { confirm_dialog_target: "proceed", action: "confirm-dialog#accept" })) { "Continue" } %>
    </div>
  </div>
</dialog>
