<%= render(CardComponent.new(title: "Today's training", id: "plan-today")) do %>
  <% if day %>
    <p class="flex flex-wrap items-center gap-2">
      <%= helpers.plan_kind_badge(day) %>
      <span class="text-sm text-gray-600 dark:text-gray-300">
        Week <%= day.week %> · Day <%= day.day %> · <%= day.phase.name %><% if helpers.plan_minutes(day) %> · <%= helpers.plan_minutes(day) %><% end %>
      </span>
      <% if done? %><span class="rounded bg-green-100 px-2 py-0.5 text-sm text-green-900 dark:bg-green-950 dark:text-green-200">done</span><% end %>
    </p>
    <p class="mt-2 text-lg font-medium"><%= day.title %></p>
    <p class="text-gray-600 dark:text-gray-300"><%= day.focus %></p>
    <div class="mt-3">
      <%= render(ButtonComponent.new(href: helpers.plan_workout_path(day.week, day.day), variant: done? ? :secondary : :primary)) { done? ? "Review the day" : "Open today's workout" } %>
    </div>
  <% elsif enrollment.rest_today? %>
    <p class="text-lg font-medium">Rest day</p>
    <p class="text-gray-600 dark:text-gray-300">You added this one. The plan picks up tomorrow.</p>
  <% elsif enrollment.starts_in.positive? %>
    <p class="text-gray-700 dark:text-gray-200">
      The plan starts <%= helpers.plan_date(enrollment.started_on) %>, in <%= helpers.pluralize(enrollment.starts_in, "day") %>.
    </p>
  <% else %>
    <p class="text-gray-700 dark:text-gray-200">
      The 12 weeks are done. <%= helpers.link_to "See how it went", helpers.training_plan_path, class: "text-blue-700 underline dark:text-blue-300" %>.
    </p>
  <% end %>
<% end %>
