<div id="live_course">
  <%# Compact, so the camera still fits on a laptop screen below it and the latest
      shot: the clock and Start match on one row, the score on one line. %>
  <%= render(CardComponent.new) do %>
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <div>
        <p class="text-sm font-medium text-gray-600 dark:text-gray-300"><%= course.name %> · <%= heading %></p>
        <% if counting? %>
          <p class="text-5xl font-bold tabular-nums" data-controller="countdown"
             data-countdown-ends-at-value="<%= state["ends_at"] %>"
             data-countdown-warn-value="<%= warn_at.first %>" data-countdown-alarm-value="<%= warn_at.last %>">–:––</p>
        <% end %>
      </div>
      <% if skippable? %>
        <%= render(ButtonComponent.new(href: helpers.start_match_practice_session_path(@session), method: :post, size: :lg,
                                       form: { data: { turbo_confirm: "End sighting time and start the match now?" } })) { "Start match" } %>
      <% end %>
    </div>

    <dl class="mt-3 flex flex-wrap items-baseline gap-x-6 gap-y-1 border-t border-gray-200 pt-3 dark:border-gray-800">
      <% [ [ "Total", total_text ], [ "Shots", "#{stats.fired} / #{course.shots}" ], [ "Sighters", stats.sighters ] ].each do |label, value| %>
        <div class="flex items-baseline gap-2">
          <dt class="text-sm text-gray-600 dark:text-gray-300"><%= label %></dt>
          <dd class="text-xl font-semibold tabular-nums"><%= value %></dd>
        </div>
      <% end %>
    </dl>

    <% if stats.series.any? %>
      <ol class="mt-3 flex flex-wrap gap-2 text-sm tabular-nums" aria-label="Series totals">
        <% stats.series.each do |n, total| %>
          <li class="rounded bg-gray-100 px-2 py-1 dark:bg-gray-800">S<%= n %> <span class="font-semibold"><%= stats.whole_rings? ? total : format("%.1f", total) %></span></li>
        <% end %>
      </ol>
    <% end %>
    <% if stats.penalties.positive? %>
      <p class="mt-2 text-sm text-red-700 dark:text-red-300"><%= pluralize(stats.penalties, "shot") %> out of time, scored zero.</p>
    <% end %>
  <% end %>
</div>
