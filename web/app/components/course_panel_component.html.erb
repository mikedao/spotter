<div id="live_course">
  <%= render(CardComponent.new(title: course.name)) do %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-gray-600 dark:text-gray-300"><%= heading %></p>
        <% if counting? %>
          <p class="text-5xl font-bold tabular-nums" data-controller="countdown"
             data-countdown-ends-at-value="<%= state["ends_at"] %>"
             data-countdown-warn-value="<%= warn_at.first %>" data-countdown-alarm-value="<%= warn_at.last %>">–:––</p>
        <% end %>
      </div>
      <% if skippable? %>
        <%= render(ButtonComponent.new(href: helpers.start_match_practice_session_path(@session), method: :post, size: :lg,
                                       form: { data: { turbo_confirm: "End sighting time and start the match now?" } })) { "Start match" } %>
      <% end %>
    </div>

    <dl class="mt-4 grid grid-cols-3 gap-x-4 gap-y-3 border-t border-gray-200 pt-4 dark:border-gray-800">
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-300">Total</dt>
        <dd class="text-2xl font-semibold tabular-nums"><%= total_text %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-300">Shots</dt>
        <dd class="text-2xl font-semibold tabular-nums"><%= stats.fired %> / <%= course.shots %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-300">Sighters</dt>
        <dd class="text-2xl font-semibold tabular-nums"><%= stats.sighters %></dd>
      </div>
    </dl>

    <% if stats.series.any? %>
      <ol class="mt-3 flex flex-wrap gap-2 text-sm tabular-nums" aria-label="Series totals">
        <% stats.series.each do |n, total| %>
          <li class="rounded bg-gray-100 px-2 py-1 dark:bg-gray-800">S<%= n %> <span class="font-semibold"><%= stats.whole_rings? ? total : format("%.1f", total) %></span></li>
        <% end %>
      </ol>
    <% end %>
    <% if stats.penalties.positive? %>
      <p class="mt-2 text-sm text-red-700 dark:text-red-300"><%= pluralize(stats.penalties, "shot") %> out of time, scored zero.</p>
    <% end %>
  <% end %>
</div>
