<% content_for :title, "Hold drill" %>
<% muted = "text-gray-600 dark:text-gray-300" %>
<% s = @settings %>
<% button = "min-h-14 cursor-pointer rounded-md px-6 text-lg font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current" %>

<p class="mb-1 text-sm">
  <%= link_to "← Hold drills", hold_drills_path, class: "text-blue-700 underline dark:text-blue-300" %>
  <% if @plan_day %>
    <% week, day = TrainingPlan.parse(@plan_day) %>
    · <%= link_to "Week #{week} · Day #{day}", plan_workout_path(week, day), class: "text-blue-700 underline dark:text-blue-300" %>
  <% end %>
</p>
<h1 class="text-2xl font-semibold">Hold drill</h1>
<p class="mt-1 <%= muted %>">
  <%= s[:reps] %> holds of <%= s[:hold_seconds] %> seconds, <%= s[:rest_seconds] %> seconds rest. Gun unloaded: no pellet, no trigger.
</p>

<div class="mt-4" data-controller="hold-drill"
     data-hold-drill-reps-value="<%= s[:reps] %>" data-hold-drill-hold-value="<%= s[:hold_seconds] %>"
     data-hold-drill-rest-value="<%= s[:rest_seconds] %>" data-hold-drill-settle-value="<%= HoldDrill::SETTLE_SECONDS %>"
     data-hold-drill-index-url-value="<%= hold_drills_path %>" data-hold-drill-cues-value="<%= @cues.to_json %>">
  <%= render(CardComponent.new) do %>
    <div class="flex flex-col items-center gap-3 py-4 text-center">
      <p class="text-lg <%= muted %>" data-hold-drill-target="rep">Ready</p>
      <p class="text-2xl font-semibold" role="status" aria-live="polite" data-hold-drill-target="phase">Press Start when you are standing ready.</p>
      <p class="text-9xl font-semibold tabular-nums text-gray-400 data-[phase=settle]:text-amber-500 data-[phase=hold]:text-green-600 data-[phase=rest]:text-blue-500 dark:data-[phase=hold]:text-green-400"
         aria-hidden="true" data-hold-drill-target="count">&nbsp;</p>
      <div class="flex flex-wrap justify-center gap-2" aria-hidden="true" data-hold-drill-target="dots"></div>

      <div class="mt-2 flex flex-wrap justify-center gap-3">
        <button type="button" class="<%= button %> bg-blue-600 text-white hover:bg-blue-500" data-hold-drill-target="start" data-action="hold-drill#start">Start</button>
        <button type="button" class="<%= button %> border border-gray-300 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" data-hold-drill-target="letDown" data-action="hold-drill#letDown" hidden>Let down</button>
        <button type="button" class="<%= button %> border border-gray-300 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" data-hold-drill-target="pause" data-action="hold-drill#pause" hidden>Pause</button>
        <button type="button" class="<%= button %> border border-gray-300 text-red-700 hover:bg-red-50 dark:border-gray-700 dark:text-red-300 dark:hover:bg-red-950" data-hold-drill-target="stop" data-action="hold-drill#stop" hidden>Stop</button>
      </div>

      <label class="mt-2 flex min-h-11 cursor-pointer items-center gap-2 text-sm <%= muted %>">
        <input type="checkbox" checked data-hold-drill-target="voice" data-action="hold-drill#rememberVoice" class="size-4">
        Say the cues out loud
        <span class="<%= muted %>">(<%= @voice.name %>, <%= link_to "change", settings_path(anchor: "voice"), class: "text-blue-700 underline dark:text-blue-300" %>)</span>
      </label>
    </div>
  <% end %>

  <%# What the timer reports at the end; submitted by the page itself. %>
  <%= form_with scope: :hold_drill, url: hold_drills_path, method: :post, class: "hidden", data: { hold_drill_target: "form" } do %>
    <%= hidden_field_tag "hold_drill[reps]", s[:reps] %>
    <%= hidden_field_tag "hold_drill[hold_seconds]", s[:hold_seconds] %>
    <%= hidden_field_tag "hold_drill[rest_seconds]", s[:rest_seconds] %>
    <%= hidden_field_tag "hold_drill[reps_done]", 0, data: { hold_drill_target: "repsDone" } %>
    <%= hidden_field_tag "hold_drill[let_downs]", 0, data: { hold_drill_target: "letDowns" } %>
    <%= hidden_field_tag "hold_drill[held_seconds]", 0, data: { hold_drill_target: "heldSeconds" } %>
    <%= hidden_field_tag :plan_day, @plan_day if @plan_day %>
  <% end %>
</div>
