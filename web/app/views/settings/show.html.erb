<% content_for :title, "Settings" %>

<h1 class="mb-4 text-2xl font-semibold">Settings</h1>

<div class="space-y-4">
  <%= render(CardComponent.new(title: "What the announcer says", id: "announcements")) do %>
    <%= form_with model: Current.user, url: settings_path, method: :patch, class: "space-y-3" do |f| %>
      <label class="flex cursor-pointer items-start gap-3">
        <%= f.check_box :diagnostic_announcements, class: "mt-1 size-5 accent-blue-600" %>
        <span>
          <span class="block font-medium">Diagnostic mode</span>
          <span class="block text-sm text-gray-600 dark:text-gray-300">
            Off: after a shot you hear its number, score and direction ("shot 4. 9.6, shot a touch low"), plus what
            counts in a match (sighter, out of time). On: also why a shot is worth a look - line call, ring uncertain,
            overlaps a hole, found without a sound, view moving, geometry warning.
          </span>
        </span>
      </label>
      <label class="flex cursor-pointer items-start gap-3">
        <%= f.check_box :chatty, class: "mt-1 size-5 accent-blue-600" %>
        <span>
          <span class="block font-medium">Chatty mode</span>
          <span class="block text-sm text-gray-600 dark:text-gray-300">
            The announcer also comments: streaks of tens, your best series, three shots in a row on one side, a flyer,
            the pace against your goal, a summary every 10 shots and after a match. Also on the range screen
            (💬 Chatty), to turn on and off mid-session.
          </span>
        </span>
      </label>
      <%= render(ButtonComponent.new(type: :submit, variant: :secondary)) { "Save" } %>
    <% end %>
  <% end %>

  <%= render(VoicePickerComponent.new(user: Current.user)) %>
</div>
