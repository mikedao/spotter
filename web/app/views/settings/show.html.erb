<% content_for :title, "Settings" %>

<h1 class="mb-4 text-2xl font-semibold">Settings</h1>

<div class="space-y-4">
  <%= render(CardComponent.new(title: "What the announcer says", id: "announcements")) do %>
    <%= form_with model: Current.user, url: settings_path, method: :patch, class: "space-y-3" do |f| %>
      <label class="flex cursor-pointer items-start gap-3">
        <%= f.check_box :diagnostic_announcements, class: "mt-1 size-5 accent-blue-600" %>
        <span>
          <span class="block font-medium">Diagnostic mode</span>
          <span class="block text-sm text-gray-600 dark:text-gray-300">
            Off: after a shot you hear its number, score and direction ("shot 4. 9.6, shot a touch low"), plus what
            counts in a match (sighter, out of time). On: also why a shot is worth a look - line call, ring uncertain,
            overlaps a hole, found without a sound, view moving, geometry warning.
          </span>
        </span>
      </label>
      <label class="flex cursor-pointer items-start gap-3">
        <%= f.check_box :chatty, class: "mt-1 size-5 accent-blue-600" %>
        <span>
          <span class="block font-medium">Chatty mode</span>
          <span class="block text-sm text-gray-600 dark:text-gray-300">
            The announcer also comments: streaks of tens, your best series, three shots in a row on one side, a flyer,
            a summary every 10 shots and after a match. Also on the range screen
            (💬 Chatty), to turn on and off mid-session.
          </span>
        </span>
      </label>
      <%= render(ButtonComponent.new(type: :submit, variant: :secondary)) { "Save" } %>
    <% end %>
  <% end %>

  <%= render(VoicePickerComponent.new(user: Current.user)) %>

  <%= render(CardComponent.new(title: "CompetitiveShooter.org", id: "competitive_shooter")) do %>
    <p class="text-sm text-gray-600 dark:text-gray-300">
      Share a finished session (or a day of training, from the journal) to your feed on CompetitiveShooter.org, as pictures.
      Make an API key on their site under Profile → API keys, and paste it here. Posts say "via Spotter";
      revoking the key there stops Spotter posting.
    </p>
    <% if Current.user.cso_connected? %>
      <p class="mt-3 text-sm">Key saved: <span class="font-mono"><%= Current.user.cso_key_hint %></span></p>
    <% end %>
    <%= form_with model: Current.user, url: competitive_shooter_setting_path, method: :patch, class: "mt-3 flex flex-wrap items-end gap-3" do |f| %>
      <label class="block grow">
        <span class="block text-sm font-medium"><%= Current.user.cso_connected? ? "Replace the key" : "API key" %></span>
        <%= f.password_field :cso_api_key, value: nil, autocomplete: "off", placeholder: "csk_…", required: true,
              class: "mt-1 w-full rounded-md border border-gray-300 bg-white px-3 py-2 font-mono text-sm dark:border-gray-700 dark:bg-gray-900" %>
      </label>
      <%= render(ButtonComponent.new(type: :submit, variant: :secondary)) { "Save key" } %>
    <% end %>
    <% if Current.user.cso_connected? %>
      <%= button_to "Remove the key", competitive_shooter_setting_path, method: :patch, params: { remove: 1 },
            class: "mt-3 text-sm text-red-700 underline dark:text-red-400", form: { data: { turbo_confirm: "Remove your CompetitiveShooter.org key from Spotter?" } } %>
    <% end %>
  <% end %>
</div>
