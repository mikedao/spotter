<% content_for :title, "Practice" %>

<h1 class="mb-4 text-2xl font-semibold">Practice</h1>

<%= render(PracticeHomeComponent.new(home: @home)) %>

<div class="mb-3 flex items-baseline justify-between gap-3">
  <h2 class="text-lg font-semibold">Sessions</h2>
  <%= link_to "Trends in the Journal →", journal_path, class: "text-sm text-blue-700 hover:underline dark:text-blue-300" %>
</div>
<% if @sessions.empty? %>
  <%= render(CardComponent.new) do %>
    <p class="text-gray-600 dark:text-gray-300">No sessions yet. Start one with New session above; it appears here and updates live as you shoot.</p>
  <% end %>
<% else %>
  <% recent, older = @sessions.first(PracticeSessionsController::RECENT_SESSIONS), @sessions.drop(PracticeSessionsController::RECENT_SESSIONS) %>
  <%= render(CardComponent.new(padding: :none)) do %>
    <ul class="divide-y divide-gray-200 dark:divide-gray-800">
      <%= render partial: "session_row", collection: recent, as: :session %>
    </ul>
    <% if older.any? %>
      <details class="group border-t border-gray-200 dark:border-gray-800">
        <summary class="flex min-h-11 cursor-pointer items-center px-4 text-sm font-medium text-blue-700 hover:bg-gray-50 dark:text-blue-300 dark:hover:bg-gray-800">
          <span class="group-open:hidden">Show all <%= @sessions.size %> sessions</span>
          <span class="hidden group-open:inline">Show only the latest <%= recent.size %></span>
        </summary>
        <ul class="divide-y divide-gray-200 border-t border-gray-200 dark:divide-gray-800 dark:border-gray-800">
          <%= render partial: "session_row", collection: older, as: :session %>
        </ul>
      </details>
    <% end %>
  <% end %>
<% end %>
