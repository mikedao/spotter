<% content_for :title, "Practice" %>

<h1 class="mb-4 text-2xl font-semibold">Practice</h1>

<div class="mb-4"><%= render(StartSessionComponent.new(running: @running, user: Current.user)) %></div>

<% if @sessions.empty? %>
  <%= render(CardComponent.new) do %>
    <p class="text-gray-600 dark:text-gray-300">No sessions yet. Start one above; it appears here and updates live as you shoot.</p>
  <% end %>
<% else %>
  <%= render(CardComponent.new(padding: :none)) do %>
    <ul class="divide-y divide-gray-200 dark:divide-gray-800">
      <% @sessions.each do |session| %>
        <% shots = session.cards.flat_map(&:scored_shots) %>
        <li class="flex items-center hover:bg-gray-50 dark:hover:bg-gray-800">
          <%= link_to practice_session_path(session), class: "flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-2 py-3 pl-4" do %>
            <span class="font-medium">
              <%= session.title %>
              <% if session.live? %><span class="ml-2 rounded bg-green-100 px-2 py-0.5 text-sm text-green-900 dark:bg-green-950 dark:text-green-200">live</span><% end %>
              <% if session.gear_label %><span class="block text-sm font-normal text-gray-600 dark:text-gray-300"><%= session.gear_label %></span><% end %>
            </span>
            <span class="tabular-nums text-gray-600 dark:text-gray-300">
              <%= pluralize(session.cards.size, "card") %> · <%= pluralize(shots.size, "shot") %>
              <% if shots.any? %> · <%= shots.sum(&:final_ring) %> (<%= shots.sum(&:final_decimal).round(1) %>)<% end %>
            </span>
          <% end %>
          <div class="shrink-0 px-2">
            <% unless session.live? %>
              <%= button_to "Delete", practice_session_path(session), method: :delete,
                    "aria-label": "Delete #{session.title}",
                    form: { data: { turbo_confirm: SessionStatusComponent.confirm_delete(session) } },
                    class: "min-h-11 cursor-pointer rounded-md px-3 text-sm text-gray-500 hover:bg-red-50 hover:text-red-700 dark:text-gray-400 dark:hover:bg-red-950 dark:hover:text-red-300" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
