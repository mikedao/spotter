<% content_for :title, @session.title %>
<%= turbo_stream_from @session %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  <h1 class="text-2xl font-semibold"><%= @session.title %></h1>
  <% if @session.live? %>
    <%= render(ButtonComponent.new(href: stop_practice_session_path(@session), method: :post, variant: :danger)) { "Stop session" } %>
  <% end %>
</div>

<div class="space-y-4">
  <%= render(SessionStatusComponent.new(session: @session)) %>
  <%= render(LivePanelComponent.new(session: @session)) %>
</div>
