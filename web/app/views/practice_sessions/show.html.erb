<% content_for :title, @session.title %>
<%= turbo_stream_from @session %>
<div class="space-y-3">
  <%# A phone held sideways (short:): one grid - the target down the left, the full
      height, and the header and everything else in a column beside it. The inner
      grids become "contents" so their parts are this grid's items. %>
  <div class="space-y-3 short:grid short:grid-cols-[auto_minmax(0,1fr)] short:items-start short:gap-x-4 short:gap-y-3 short:space-y-0">
  <%# The header: title + status on the left, ONE toolbar on the right - the
      session's controls (broadcast, replaced on every event) and the Mic / Chatty /
      Sound buttons (outside every broadcast, so they keep listening and playing
      through every shot). Wide, it is one line that never wraps: the left side
      truncates, so the buttons never move. Narrower, the toolbar is always its own
      row (by rule, not by whatever happens to fit). %>
  <div class="short:col-start-2 short:row-start-1">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 wide:flex-nowrap short:gap-x-2">
      <div class="min-w-0 basis-full wide:flex-1 wide:basis-0"><%= render(SessionStatusComponent.new(session: @session, part: :status)) %></div>
      <div role="toolbar" aria-label="Session controls" class="flex basis-full flex-wrap items-center gap-2 wide:shrink-0 wide:basis-auto wide:flex-nowrap">
        <%= render(SessionStatusComponent.new(session: @session, part: :controls)) %>
        <% if @session.live? %>
          <span class="mx-1 h-6 w-px bg-gray-300 max-sm:hidden dark:bg-gray-700" aria-hidden="true"></span>
          <%= render(BrowserTriggerComponent.new(session: @session)) %>
          <%= render(AnnouncerComponent.new(session: @session)) %>
        <% end %>
      </div>
    </div>
    <%= render(SessionStatusComponent.new(session: @session, part: :error)) %>
  </div>

  <%# What the training plan set for this session, if it was started from a plan block. %>
  <%= render(PlanBlockComponent.new(session: @session)) %>
  <%= render(PlanLinkComponent.new(session: @session)) %>

  <%# Target (sized by the window's height) and a right column capped at 32rem,
      centred together: on a wide screen the spare width becomes even margins
      rather than a stretched column. %>
  <% if @session.live? %>
    <%# The plot panel: a capture loads into it (ShotsController#plot) and it opens
        over the range screen, which keeps going underneath. %>
    <dialog data-controller="plot-dialog" aria-label="Plot a shot that wasn't scored"
            class="m-auto w-[min(56rem,calc(100vw-2rem))] rounded-lg border border-gray-200 bg-white p-0 text-gray-900 shadow-xl backdrop:bg-black/60 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-100">
      <turbo-frame id="plot" data-plot-dialog-target="frame"></turbo-frame>
    </dialog>
    <div class="grid items-start gap-4 wide:grid-cols-[auto_minmax(0,32rem)] wide:justify-center short:contents">
      <%= render(LivePanelComponent.new(session: @session, section: :target)) %>
      <%# An iPad upright (tall:): the panels in two columns under the target. %>
      <div id="range_side" class="space-y-3 short:col-start-2 short:row-start-2 tall:grid tall:grid-cols-2 tall:items-start tall:gap-3 tall:space-y-0">
        <%= render(CoursePanelComponent.new(session: @session)) %>
        <%= render(LivePanelComponent.new(session: @session, section: :latest)) %>
        <%= render(LiveCameraComponent.new(session: @session)) %>
        <%= render(LivePanelComponent.new(session: @session, section: :stats)) %>
        <%# The shot list continues the column below the camera. %>
        <%= render(LivePanelComponent.new(session: @session, section: :list)) %>
      </div>
    </div>
  <% else %>
    <%# Finished: the whole session - every competition shot on one target, the
        result, and every card (each its own page). %>
    <% all = SessionSummary.new(@session).shots %>
    <div class="grid items-start gap-4 wide:grid-cols-[auto_minmax(0,32rem)] wide:justify-center short:contents">
      <div id="session_target" class="<%= LivePanelComponent::TARGET_SIZE %>">
        <%= render(CardComponent.new(padding: :none, class: "relative p-2")) do %>
          <span class="absolute left-4 top-3 text-sm font-semibold text-gray-700">All <%= pluralize(all.size, "shot") %></span>
          <%= render(TargetSvgComponent.new(spec: @session.target_spec, shots: all, in_order: true, label: "All shots in this session")) %>
        <% end %>
      </div>
      <div id="range_side" class="space-y-3 short:col-start-2 short:row-start-2">
        <%= render(SessionResultComponent.new(session: @session)) %>
      </div>
    </div>
  <% end %>
  </div>

  <%= render(SessionDiaryComponent.new(session: @session)) %>
  <%= render(SessionGearComponent.new(session: @session)) %>
  <%= render(CardComponent.new(title: "Export", id: "export")) do %>
    <div class="flex flex-wrap gap-3">
      <%= render(ButtonComponent.new(href: practice_session_report_path(@session), variant: :secondary)) { "Report (PDF)" } %>
      <%= render(ButtonComponent.new(href: practice_session_shotmetrix_path(@session), variant: :secondary)) { "Shotmetrix QR code" } %>
      <% unless @session.live? %>
        <%= render(ButtonComponent.new(href: new_share_path(session_ids: [ @session.id ]), variant: :secondary)) { "Share to CompetitiveShooter.org" } %>
      <% end %>
    </div>
    <% if (posts = Current.user.shared_posts.showing(@session)).any? %>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">Posted to CompetitiveShooter.org:
        <% posts.each_with_index do |post, i| %><%= ", " if i.positive? %><%= link_to post.created_at.strftime("%b %-d, %H:%M"), post.url, class: "font-medium text-blue-700 underline dark:text-blue-300", target: "_blank", rel: "noopener" %><% end %></p>
    <% end %>
  <% end %>
</div>
