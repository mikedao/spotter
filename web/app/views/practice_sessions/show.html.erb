<% content_for :title, @session.title %>
<%= turbo_stream_from @session %>

<div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
  <h1 class="text-2xl font-semibold"><%= @session.title %></h1>
  <span class="text-gray-600 dark:text-gray-300"><%= @session.rule %> rule</span>
</div>

<div class="space-y-4">
  <%= render(SessionStatusComponent.new(session: @session)) %>
  <%= render(LivePanelComponent.new(session: @session)) %>
</div>
