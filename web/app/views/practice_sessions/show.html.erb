<% content_for :title, @session.title %>
<%= turbo_stream_from @session %>
<div class="space-y-3">
  <%# The header (broadcast, replaced on every event) and, beside it, the live
      announcer's Sound button - outside it, so it keeps playing through every shot,
      and on the header's line so the column below doesn't grow. %>
  <div class="flex flex-wrap items-start gap-3">
    <div class="min-w-0 flex-1"><%= render(SessionStatusComponent.new(session: @session)) %></div>
    <%= render(AnnouncerComponent.new(session: @session)) %>
  </div>

  <%# Target (sized by the window's height) and a right column capped at 32rem,
      centred together: on a wide screen the spare width becomes even margins
      rather than a stretched column. %>
  <% if @session.live? %>
    <div class="grid items-start gap-4 lg:grid-cols-[auto_minmax(0,32rem)] lg:justify-center">
      <%= render(LivePanelComponent.new(session: @session, section: :target)) %>
      <div id="range_side" class="space-y-3">
        <%= render(CoursePanelComponent.new(session: @session)) %>
        <%= render(LivePanelComponent.new(session: @session, section: :latest)) %>
        <%= render(LiveCameraComponent.new(session: @session)) %>
        <%= render(LivePanelComponent.new(session: @session, section: :stats)) %>
        <%# The shot list continues the column below the camera. %>
        <%= render(LivePanelComponent.new(session: @session, section: :list)) %>
      </div>
    </div>
  <% else %>
    <%# Finished: the whole session - every competition shot on one target, the
        result, and every card (each its own page). %>
    <% all = SessionSummary.new(@session).shots %>
    <div class="grid items-start gap-4 lg:grid-cols-[auto_minmax(0,32rem)] lg:justify-center">
      <div id="session_target" class="<%= LivePanelComponent::TARGET_SIZE %>">
        <%= render(CardComponent.new(padding: :none, class: "relative p-2")) do %>
          <span class="absolute left-4 top-3 text-sm font-semibold text-gray-700">All <%= pluralize(all.size, "shot") %></span>
          <%= render(TargetSvgComponent.new(spec: @session.target_spec, shots: all, in_order: true, label: "All shots in this session")) %>
        <% end %>
      </div>
      <div id="range_side" class="space-y-3">
        <%= render(SessionResultComponent.new(session: @session)) %>
      </div>
    </div>
  <% end %>

  <%= render(SessionDiaryComponent.new(session: @session)) %>
  <%= render(SessionGearComponent.new(session: @session)) %>
  <%= render(CardComponent.new(title: "Export", id: "export")) do %>
    <div class="flex flex-wrap gap-3">
      <%= render(ButtonComponent.new(href: practice_session_report_path(@session), variant: :secondary)) { "Report (PDF)" } %>
      <%= render(ButtonComponent.new(href: practice_session_shotmetrix_path(@session), variant: :secondary)) { "Shotmetrix QR code" } %>
    </div>
  <% end %>
</div>
