<% content_for :title, @session.title %>
<%= turbo_stream_from @session %>
<div class="space-y-3">
  <%= render(SessionStatusComponent.new(session: @session)) %>

  <div class="grid items-start gap-4 lg:grid-cols-[auto_minmax(0,1fr)]">
    <%= render(LivePanelComponent.new(session: @session, section: :target)) %>
    <div class="space-y-4">
      <%= render(CoursePanelComponent.new(session: @session)) %>
      <%= render(LivePanelComponent.new(session: @session, section: :latest)) %>
      <%= render(LiveCameraComponent.new(session: @session)) %>
      <%= render(LivePanelComponent.new(session: @session, section: :stats)) %>
    </div>
  </div>

  <%= render(LivePanelComponent.new(session: @session, section: :list)) %>
  <%= render(SessionGearComponent.new(session: @session)) %>
</div>
