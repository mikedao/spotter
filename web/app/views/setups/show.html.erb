<% content_for :title, "Rig setup" %>
<%= turbo_stream_from Current.user, :setup %>

<h1 class="mb-1 text-2xl font-semibold">Rig setup</h1>
<p class="mb-4 text-gray-600 dark:text-gray-300">Check the camera can see and score the card, and that the microphone hears your shots, before a session.</p>

<div class="space-y-4">
  <%= render(CardComponent.new(title: "Camera check", id: "camera")) do %>
    <%= form_with url: locate_setup_path, class: "mb-4 flex flex-wrap items-end gap-4" do |f| %>
      <div>
        <%= f.label :camera, "Camera", class: "mb-1 block text-sm font-medium" %>
        <% options = (@probe&.cameras || []).map { [ "#{it.label} (camera #{it.index})", it.value ] } %>
        <% options.unshift([ "Camera #{@camera}", @camera ]) unless @camera.include?("://") || options.any? { it[1] == @camera } %>
        <% options << [ "Stream URL…", "url" ] %>
        <%= f.select :camera, options, { selected: @camera.include?("://") ? "url" : @camera }, class: "#{TextFieldComponent::INPUT} max-w-xs" %>
      </div>
      <div>
        <%= f.label :camera_url, "Stream URL (if chosen)", class: "mb-1 block text-sm font-medium" %>
        <%= f.url_field :camera_url, value: (@camera if @camera.include?("://")), placeholder: "http://<pi>:8080/stream", class: "#{TextFieldComponent::INPUT} w-72" %>
      </div>
      <div>
        <%= f.label :target, "Target", class: "mb-1 block text-sm font-medium" %>
        <%= f.select :target, TargetSpec::SPECS.values.map { [ it.name, it.key ] }, {}, class: TextFieldComponent::INPUT %>
      </div>
      <%= f.button "Start live check", class: "inline-flex min-h-11 cursor-pointer items-center rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-medium text-white hover:bg-blue-500",
                   data: { turbo_submits_with: "Starting…" } %>
    <% end %>
    <%= render(LocatePanelComponent.new(state: @locate_state, latest: @locate)) %>
  <% end %>

  <%= render(CardComponent.new(title: "Sound check", id: "sound")) do %>
    <%= form_with url: listen_setup_path, class: "mb-4 flex flex-wrap items-end gap-4" do |f| %>
      <div>
        <%= f.label :mic, "Microphone", class: "mb-1 block text-sm font-medium" %>
        <% mics = (@probe&.microphones || []).map(&:name) %>
        <% mics.unshift(@mic) unless mics.include?(@mic) || @mic == CameraProbe::NO_MIC %>
        <%= f.select :mic, mics, { selected: @mic }, class: "#{TextFieldComponent::INPUT} max-w-xs" %>
      </div>
      <div>
        <%= f.label :seconds, "For (seconds)", class: "mb-1 block text-sm font-medium" %>
        <%= f.number_field :seconds, value: 60, min: 5, max: RigCheck::Listen::MAX_SECONDS, class: "#{TextFieldComponent::INPUT} w-24" %>
      </div>
      <%= f.button "Listen", class: "inline-flex min-h-11 cursor-pointer items-center rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-medium text-white hover:bg-blue-500" %>
    <% end %>
    <%= render(ListenPanelComponent.new(state: @listen, user: Current.user)) %>
  <% end %>

  <p class="text-sm text-gray-600 dark:text-gray-300">
    Don't see your camera or microphone? Use <strong>Find cameras and microphones</strong> on the
    <%= link_to "Practice", practice_sessions_path, class: "text-blue-700 underline dark:text-blue-300" %> page.
  </p>
</div>
