<% content_for :title, @gun.name %>
<% muted = "text-gray-600 dark:text-gray-300" %>

<div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2">
  <h1 class="text-2xl font-semibold"><%= @gun.name %></h1>
  <span class="<%= muted %>"><%= [ @gun.make_model.presence, @gun.kind_name, ("retired" if @gun.retired?) ].compact.join(" · ") %></span>
  <div class="ml-auto"><%= render(ButtonComponent.new(href: edit_gun_path(@gun), variant: :secondary, size: :sm)) { "Edit" } %></div>
</div>
<% if @gun.notes.present? %><p class="mb-4 max-w-prose whitespace-pre-line"><%= @gun.notes %></p><% end %>

<%= render(CardComponent.new(title: "Sessions and adjustments", padding: :none)) do %>
  <% if @sessions.empty? %>
    <p class="px-4 pb-4 <%= muted %>">Not shot yet. Pick it when you start a session.</p>
  <% else %>
    <ul class="divide-y divide-gray-200 border-t border-gray-200 dark:divide-gray-800 dark:border-gray-800">
      <% @sessions.each do |session| %>
        <% shots = session.cards.flat_map(&:scored_shots) %>
        <li>
          <%= link_to practice_session_path(session), class: "block px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800" do %>
            <span class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-medium"><%= session.title %></span>
              <span class="tabular-nums <%= muted %>">
                <%= pluralize(shots.size, "shot") %><% if shots.any? %> · <%= shots.sum(&:final_ring) %> (<%= shots.sum(&:final_decimal).round(1) %>)<% end %>
              </span>
            </span>
            <span class="block text-sm <%= muted %>"><%= session.pellet&.label || "pellets not noted" %></span>
            <% if session.gun_adjustments.present? %>
              <span class="mt-1 block whitespace-pre-line text-sm"><span class="font-medium">Adjusted:</span> <%= session.gun_adjustments %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
