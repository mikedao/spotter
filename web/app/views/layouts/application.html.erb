<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Spotter" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Spotter">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#030712">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# An application, not a website: no top bar. The menu is a drawer that slides
      out from the ☰ button, which floats beside each screen's heading. %>
  <body class="min-h-screen bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100"
        data-controller="drawer" data-action="keydown.esc@window->drawer#close">
    <% if current_user %>
      <% here = { "practice_sessions" => :practice, "session_setup" => :practice, "shots" => :practice, "shotmetrix" => :practice, "journals" => :journal, "gear" => :gear, "guns" => :gear, "pellets" => :gear, "settings" => :settings }[controller_name] %>
      <% item = "flex min-h-11 items-center gap-3 rounded-md px-3 text-gray-300 hover:bg-white/10 hover:text-white" %>
      <% current = "bg-white/10 font-medium text-white" %>

      <div class="fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none transition-opacity"
           data-drawer-target="backdrop" data-action="click->drawer#close"></div>

      <nav id="drawer" aria-label="Menu"
           class="invisible fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col bg-gray-900 p-3 text-white shadow-xl transition"
           data-drawer-target="panel">
        <div class="mb-4 flex items-center justify-between pl-3">
          <span class="text-lg font-semibold tracking-tight">Spotter</span>
          <button type="button" class="grid size-11 cursor-pointer place-items-center rounded-md text-gray-300 hover:bg-white/10 hover:text-white"
                  aria-label="Close menu" data-action="drawer#close">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>

        <%= link_to practice_sessions_path, class: class_names(item, current => here == :practice), "aria-current": ("page" if here == :practice) do %>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>
          Practice
        <% end %>
        <%= link_to journal_path, class: class_names(item, current => here == :journal), "aria-current": ("page" if here == :journal) do %>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19V5M4 19h16M7 15l4-4 3 3 5-6"/></svg>
          Journal
        <% end %>
        <%= link_to gear_path, class: class_names(item, current => here == :gear), "aria-current": ("page" if here == :gear) do %>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9h15l3-2v4H8l-1 6H4l1-6H3z"/><path d="M11 11v3h3"/></svg>
          Guns and pellets
        <% end %>
        <%= link_to settings_path, class: class_names(item, current => here == :settings), "aria-current": ("page" if here == :settings) do %>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
          Settings
        <% end %>

        <div class="mt-auto border-t border-white/10 pt-3">
          <p class="truncate px-3 pb-1 text-sm text-gray-400"><%= current_user.name %></p>
          <%= button_to session_path, method: :delete, class: "#{item} w-full cursor-pointer" do %>
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 8l-4 4 4 4M6 12h10"/></svg>
            Sign out
          <% end %>
        </div>
      </nav>
    <% end %>

    <main class="w-full px-4 pt-4 pb-6 sm:px-6">
      <% if current_user %>
        <button type="button" aria-label="Menu" aria-controls="drawer" aria-expanded="false"
                class="float-left mr-3 grid size-9 cursor-pointer place-items-center rounded-md text-gray-600 hover:bg-gray-200 dark:text-gray-300 dark:hover:bg-gray-800"
                data-drawer-target="button" data-action="drawer#open">
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      <% end %>
      <% flash.each do |kind, message| %>
        <div class="<%= kind == "alert" ? "bg-red-100 text-red-900 dark:bg-red-950 dark:text-red-200" : "bg-green-100 text-green-900 dark:bg-green-950 dark:text-green-200" %> mb-4 flow-root rounded-md px-4 py-3"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
