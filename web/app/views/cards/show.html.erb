<% content_for :title, "Card #{@card.number} · #{@session.title}" %>
<% link = "inline-flex min-h-11 items-center text-blue-700 hover:underline dark:text-blue-300" %>

<div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
  <h1 class="text-2xl font-semibold">Card <%= @card.number %></h1>
  <%= link_to "Back to the session", practice_session_path(@session), class: link %>
</div>
<nav class="mb-4 flex flex-wrap items-center gap-x-4 text-sm" aria-label="Cards in this session">
  <span class="text-gray-600 dark:text-gray-300"><%= @session.title %> · card <%= @card.number %> of <%= @session.cards.size %></span>
  <% if @previous %><%= link_to "← Card #{@previous}", practice_session_card_path(@session, @previous), class: link %><% end %>
  <% if @next %><%= link_to "Card #{@next} →", practice_session_card_path(@session, @next), class: link %><% end %>
</nav>

<div class="grid items-start gap-4 lg:grid-cols-[auto_minmax(0,32rem)] lg:justify-center">
  <div class="<%= LivePanelComponent::TARGET_SIZE %>">
    <%= render(CardComponent.new(padding: :none, class: "p-2")) do %>
      <%= render(TargetSvgComponent.new(spec: @session.target_spec, shots: @card.scored_shots, label: "Card #{@card.number}")) %>
    <% end %>
  </div>
  <div class="space-y-3">
    <%= render(CardStatsComponent.new(stats: @card.stats, title: "Card #{@card.number}")) %>
    <%= render(ShotListComponent.new(shots: @card.shots.sort_by { [ it.fired_at, it.id ] }, deletable: true)) %>
  </div>
</div>
