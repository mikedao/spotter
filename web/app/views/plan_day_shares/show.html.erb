<% content_for :title, "Post · Week #{@share.day.week} · #{@share.day.title}" %>
<% muted = "text-gray-600 dark:text-gray-300" %>
<% posted = @share.posted.to_a %>
<% look = @look %>

<p class="mb-1 text-sm"><%= link_to "← #{@share.day.title}", plan_workout_path(@share.day.week, @share.day.day), class: "text-blue-700 underline dark:text-blue-300" %></p>
<h1 class="mb-1 text-2xl font-semibold">Post the day to CompetitiveShooter.org</h1>
<p class="mb-4 <%= muted %>">
  Week <%= @share.day.week %> · Day <%= @share.day.day %> · <%= @share.date_text %>.
  Pick the pictures, the colors and the words: the previews are exactly what goes out, and nothing is posted until you press Post.
  <% if posted.any? %>
    Already posted <%= link_to posted.first.created_at.strftime("%b %-d, %H:%M"), posted.first.url, class: "font-medium text-blue-700 underline dark:text-blue-300", target: "_blank", rel: "noopener" %>; posting again makes another post.
  <% end %>
</p>

<% unless Current.user.cso_connected? %>
  <%= render(CardComponent.new(class: "mb-4 max-w-3xl")) do %>
    <p>To post, add your CompetitiveShooter.org API key in <%= link_to "Settings", settings_path(anchor: "competitive_shooter"), class: "font-medium text-blue-700 underline dark:text-blue-300" %>.
      You can make the post meanwhile.</p>
  <% end %>
<% end %>

<%= form_with url: plan_day_share_path(@share.day.week, @share.day.day), method: :post,
              data: { controller: "post-composer", post_composer_max_value: CompetitiveShooter::MAX_IMAGES },
              class: "grid gap-6 lg:grid-cols-[minmax(0,1fr)_26rem] lg:items-start" do %>

  <%# The pictures, as the very JPEGs that will be posted. Tick up to four. %>
  <fieldset>
    <legend class="mb-2 flex w-full flex-wrap items-baseline justify-between gap-2">
      <span class="font-medium">Pictures</span>
      <span class="text-sm <%= muted %>" data-post-composer-target="count"></span>
    </legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <% @kinds.each do |kind, label| %>
        <label class="group block cursor-pointer" data-kind="<%= kind %>">
          <span class="relative block overflow-hidden rounded-lg border border-gray-200 bg-gray-950 dark:border-gray-800">
            <img src="<%= plan_day_share_picture_path(@share.day.week, @share.day.day, kind, **look.to_params) %>" loading="lazy"
                 alt="<%= label %>, as it will be posted" data-post-composer-target="image"
                 class="block h-auto w-full opacity-35 transition-opacity group-has-[:checked]:opacity-100">
          </span>
          <span class="mt-2 flex min-h-11 items-center gap-2">
            <%= check_box_tag "pictures[]", kind, @pictures.include?(kind), id: "picture_#{kind}", class: "size-5 accent-blue-600",
                  data: { post_composer_target: "pick", action: "post-composer#limit" } %>
            <span class="font-medium"><%= label %></span>
          </span>
        </label>
      <% end %>
    </div>
    <p class="mt-2 text-sm <%= muted %>">Up to <%= CompetitiveShooter::MAX_IMAGES %> per post, in this order.</p>
  </fieldset>

  <div class="space-y-5 lg:sticky lg:top-4">
    <%= render ColorwayPickerComponent.new(checked: look.colors, input_data: { preview_param: "colors", action: "post-composer#refresh" }) %>

    <label class="flex cursor-pointer items-start gap-3">
      <%= hidden_field_tag :identity, 0, id: nil %>
      <input type="checkbox" name="identity" value="1" <%= "checked" if look.identity %> class="mt-1 size-5 accent-blue-600"
             data-preview-param="identity" data-action="post-composer#refresh">
      <span>
        <span class="block font-medium">Put my name and gear on the pictures</span>
        <span class="block text-sm <%= muted %>"><%= [ Current.user.display_name, *@share.session_set&.guns, *@share.session_set&.pellets ].compact.join(" · ") %></span>
      </span>
    </label>

    <fieldset class="space-y-3 rounded-lg border border-gray-200 p-3 dark:border-gray-800">
      <legend class="px-1 text-sm font-medium">The day's card</legend>
      <label class="block">
        <span class="block text-sm">Headline <span class="<%= muted %>">(blank: the day's title)</span></span>
        <input type="text" name="headline" value="<%= look.headline %>" maxlength="<%= PlanDayShare::HEADLINE_MAX %>" placeholder="<%= @share.day.title %>"
               class="<%= TextFieldComponent::INPUT %> mt-1" data-preview-param="headline" data-action="input->post-composer#type">
      </label>
      <% if @share.note.present? %>
        <label class="flex min-h-11 cursor-pointer items-center gap-3">
          <%= hidden_field_tag :show_note, 0, id: nil %>
          <input type="checkbox" name="show_note" value="1" <%= "checked" if look.note %> class="size-5 accent-blue-600"
                 data-preview-param="show_note" data-action="post-composer#refresh">
          <span>Show my note on it</span>
        </label>
      <% end %>
      <label class="flex min-h-11 cursor-pointer items-center gap-3">
        <%= hidden_field_tag :show_progress, 0, id: nil %>
        <input type="checkbox" name="show_progress" value="1" <%= "checked" if look.progress %> class="size-5 accent-blue-600"
               data-preview-param="show_progress" data-action="post-composer#refresh">
        <span>Show the plan's progress (<%= @share.done_count %> of <%= @share.workout_count %> days)</span>
      </label>
    </fieldset>

    <label class="block">
      <span class="block text-sm font-medium">Caption</span>
      <%= text_area_tag :body, @body, rows: 9, maxlength: CompetitiveShooter::BODY_MAX,
            class: "mt-1 w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-900" %>
    </label>

    <fieldset>
      <legend class="text-sm font-medium">Topics <span class="font-normal <%= muted %>">(up to <%= CompetitiveShooter::MAX_TOPICS %>)</span></legend>
      <div class="mt-1 space-y-1">
        <% CompetitiveShooter::TOPICS.each do |slug, name| %>
          <label class="flex min-h-11 cursor-pointer items-center gap-2">
            <%= check_box_tag "topics[]", slug, @topics.include?(slug), id: "topic_#{slug}", class: "size-5 accent-blue-600" %>
            <span><%= name %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <p class="text-sm <%= muted %>">Everyone on CompetitiveShooter.org can see the post. It says "via Spotter".</p>
    <div class="flex flex-wrap gap-3">
      <%= render(ButtonComponent.new(type: :submit, disabled: !Current.user.cso_connected?, data: { turbo_submits_with: "Posting…" })) { posted.any? ? "Post again" : "Post" } %>
      <%= render(ButtonComponent.new(href: plan_workout_path(@share.day.week, @share.day.day), variant: :ghost)) { "Not now" } %>
    </div>
  </div>
<% end %>
