<% content_for :title, "New session: start" %>

<h1 class="mb-1 text-2xl font-semibold">New session</h1>
<%= render(WizardStepsComponent.new(current: :start)) %>


<%= render(CardComponent.new(title: "Ready")) do %>
  <% passed = "text-green-700 dark:text-green-300" %>
  <% skipped = "text-amber-700 dark:text-amber-300" %>
  <dl class="mb-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
    <dt class="text-gray-600 dark:text-gray-300">Target</dt>
    <dd class="font-medium"><%= @target.name %></dd>

    <dt class="text-gray-600 dark:text-gray-300">Camera</dt>
    <dd>
      <span class="font-medium"><%= @camera.include?("://") ? @camera : "camera #{@camera}" %></span>
      <% if @camera_ok %><span class="<%= passed %>">✓ check passed</span>
      <% else %><span class="<%= skipped %>">! check not passed - <%= link_to "check again", setup_check_path, class: "underline" %></span><% end %>
    </dd>

    <dt class="text-gray-600 dark:text-gray-300">Microphone</dt>
    <dd>
      <% if @mic == CameraProbe::NO_MIC %>
        <span class="font-medium">None - camera only</span> <span class="text-gray-600 dark:text-gray-300">(2-4 s per shot)</span>
      <% else %>
        <span class="font-medium"><%= @mic == CameraProbe::BROWSER_MIC ? "This device's microphone" : @mic %></span>
        <span class="text-sm text-gray-600 dark:text-gray-300">(trigger +<%= SoundTrigger.level(Current.user, @mic).round %> dB)</span>
        <% if @mic_ok %>
          <span class="<%= passed %>">✓ heard a shot</span>
          <span class="text-sm text-gray-600 dark:text-gray-300">(sound check <%= l(@mic_checked_at, format: "%b %-d") if @mic_checked_at %>)
            - <%= link_to "check again or change", setup_microphone_path(again: 1), class: "underline" %></span>
        <% else %><span class="<%= skipped %>">! no shot heard - <%= link_to "listen again", setup_microphone_path(again: 1), class: "underline" %></span><% end %>
      <% end %>
    </dd>

    <dt class="text-gray-600 dark:text-gray-300">Announcer</dt>
    <dd>
      <span class="font-medium"><%= Voice.available? ? Voice.for(Current.user).name : "the Mac voice" %></span>
      (<%= link_to "change in Settings", settings_path(anchor: "voice"), class: "text-blue-700 underline dark:text-blue-300" %>)
    </dd>
  </dl>

  <%= form_with model: PracticeSession.new, url: practice_sessions_path, id: "start_session", class: "space-y-5", data: { controller: "start-choice" } do |f| %>
    <%= f.hidden_field :target, value: @target.key %>
    <%= f.hidden_field :camera, value: @camera %>
    <%= f.hidden_field :mic, value: @mic %>
    <%= render(GearFieldsComponent.new(form: f, choice: @gear, target: @target.key, return_to: "setup")) %>
    <% plan_spec = @plan&.block&.session %>
    <%# The plan block's card: its own per_card, never more than the block's shots. %>
    <% plan_per_card = plan_spec && [ plan_spec.per_card, @plan.block.shots || plan_spec.per_card ].min %>
    <% option = "flex cursor-pointer gap-3 rounded-md border border-gray-300 p-3 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 dark:border-gray-700 dark:has-[:checked]:bg-blue-950" %>
    <fieldset>
      <legend class="mb-2 text-sm font-medium">What are you shooting?</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <% if @plan %>
          <%# The plan block this session was started for: its own option, picked. %>
          <% block = @plan.block %>
          <% cards = block.shots ? Array.new(block.shots / plan_per_card, plan_per_card) + [ block.shots % plan_per_card ].reject(&:zero?) : [] %>
          <label class="<%= option %> sm:col-span-2" data-plan-option>
            <%= f.radio_button :mode, "plan", checked: true, class: "mt-1 accent-blue-600",
                  data: { action: "start-choice#pick", per_card: plan_per_card, group_of: plan_spec.group || 0 } %>
            <span class="min-w-0">
              <span class="block text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300">From your training plan</span>
              <span class="block text-lg font-semibold"><%= block.name %></span>
              <span class="block text-sm text-gray-600 dark:text-gray-300">Week <%= @plan.day.week %> · Day <%= @plan.day.day %> · <%= @plan.day.title %></span>
              <span class="mt-2 flex flex-wrap gap-1.5 text-sm">
                <% facts = [ (plan_spec.course ? Course::ALL.fetch(plan_spec.course).name : "Practice"),
                             ("#{block.shots} shots" if block.shots),
                             ("#{pluralize(cards.size, 'card')} of #{plan_per_card}#{" (last one #{cards.last})" if cards.size > 1 && cards.last != plan_per_card}" if cards.any?),
                             ("#{plan_spec.group}-shot groups measured live" if plan_spec.group),
                             *plan_spec.tags.map { "#{it}" } ].compact %>
                <% facts.each do |fact| %><span class="rounded bg-white px-2 py-0.5 ring-1 ring-gray-200 dark:bg-gray-900 dark:ring-gray-700"><%= fact %></span><% end %>
              </span>
              <span class="mt-2 block text-gray-700 dark:text-gray-200"><%= block.detail %></span>
              <span class="mt-1 block text-sm text-gray-600 dark:text-gray-300">Counts for your plan<% if plan_spec.tags.any? %> and is tagged <%= plan_spec.tags.to_sentence %><% end %>. Pick another option to shoot something else instead.</span>
            </span>
          </label>
        <% end %>
        <% ([ [ "", "Practice", "No clock; every shot counts. Change cards whenever you like." ] ] +
            Course::ALL.values.map { [ it.key, it.name, it.description ] }).each do |key, name, about| %>
          <label class="<%= option %>">
            <%= f.radio_button :mode, key, checked: !@plan && key.empty?, class: "mt-1 accent-blue-600",
                  data: { action: "start-choice#pick", per_card: 10, group_of: 0 } %>
            <span><span class="block font-medium"><%= name %></span><span class="text-sm text-gray-600 dark:text-gray-300"><%= about %></span></span>
          </label>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
        In a match or final the range officer calls each command and the clock runs; shots out of time score zero.
      </p>
    </fieldset>
    <div class="flex flex-wrap gap-x-8 gap-y-4">
      <div>
        <%= f.label :per_card, "Shots per card", class: "mb-1 block text-sm font-medium" %>
        <%= f.number_field :per_card, value: (plan_per_card || 10), min: 1, max: 60, class: "#{TextFieldComponent::INPUT} w-24",
            data: { start_choice_target: "perCard" } %>
      </div>
      <fieldset>
        <legend class="mb-1 text-sm font-medium">Groups</legend>
        <div class="flex flex-wrap gap-2">
          <% [ [ 0, "One per card" ], [ 5, "Every 5 shots" ] ].each do |value, label| %>
            <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-gray-300 px-3 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 dark:border-gray-700 dark:has-[:checked]:bg-blue-950">
              <%= f.radio_button :group_of, value, checked: value == (plan_spec&.group || 0), class: "accent-blue-600" %> <%= label %>
            </label>
          <% end %>
        </div>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Every 5 shots: the range screen measures each group of five live, without changing the card.</p>
      </fieldset>
    </div>
  <% end %>

  <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-gray-200 pt-4 dark:border-gray-800">
    <%= render(ButtonComponent.new(type: :submit, size: :lg, form: "start_session", data: { turbo_submits_with: "Starting…" })) { "Start session" } %>
    <span class="text-sm text-gray-600 dark:text-gray-300">Wait for "ready" before your first shot.</span>
    <%= link_to "Cancel", practice_sessions_path, class: "ml-auto text-sm text-gray-600 underline dark:text-gray-300" %>
  </div>
<% end %>
